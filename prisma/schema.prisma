generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}
enum BlockStatus {
  PENDING
  REJECTED
  APPROVED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  photo     String?
  domain    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model MailEvent {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  event       String
  occurredAt  DateTime
  postalMsgId Int?
  token       String?
  direction   String?
  messageId   String?
  toAddress   String?
  fromAddress String?
  subject     String?
  status      String?
  details     String?
  output      String?
  sentWithSsl Boolean?
  durationSec Float?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([toAddress])
  @@index([occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)])
}

model BlockList {
  id        Int      @id @default(autoincrement())
  email     String    @unique
  reason    String?
  domain    String?
  status    BlockStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
