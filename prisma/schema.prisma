generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}

model MailEvent {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  event       String
  occurredAt  DateTime
  postalMsgId Int?
  token       String?
  direction   String?
  messageId   String?
  toAddress   String?
  fromAddress String?
  subject     String?
  status      String?
  details     String?
  output      String?
  sentWithSsl Boolean?
  durationSec Float?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([toAddress])
}