generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}

// State of a block-list entry. Entries are BLOCKED by default.
enum BlockStatus {
  BLOCKED            // default
  UNBLOCK_REQUESTED  // a user asked for review
  UNBLOCKED          // request approved
}

// State of an individual unblock request.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(false)
  password  String
  photo     String?
  domain    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  unblockRequests UnblockRequest[] @relation("RequestedBy")
  reviewedRequests UnblockRequest[] @relation("ReviewedBy")
}

model MailEvent {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  event       String
  occurredAt  DateTime
  postalMsgId Int?
  token       String?
  direction   String?
  messageId   String?
  toAddress   String?
  fromAddress String?
  subject     String?
  status      String?
  details     String?
  output      String?
  sentWithSsl Boolean?
  durationSec Float?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([toAddress])
  @@index([occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)])
}

model BlockList {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  reason    String?
  domain    String?
  status    BlockStatus @default(BLOCKED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  unblockRequests UnblockRequest[]

  @@index([status])
  @@index([domain])
}

model UnblockRequest {
  id            Int           @id @default(autoincrement())
  blockListId   Int
  blockList     BlockList     @relation(fields: [blockListId], references: [id], onDelete: Cascade)
  requestedById Int
  requestedBy   User          @relation("RequestedBy", fields: [requestedById], references: [id])
  message       String?       // user's justification
  status        RequestStatus @default(PENDING)
  reviewedById  Int?
  reviewedBy    User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([blockListId, status])
  @@index([requestedById])
}
